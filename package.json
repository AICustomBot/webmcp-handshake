{
  "name": "webmcp-handshake",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-golden-journey.mjs",
    "test:e2e": "uv run --with playwright python3 scripts/test-e2e-browser.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
